# Copiar a .env y completar. Nada de esto va a git.
# General
BRAIN_MODEL=opencode/mimo-v2.6-flash-free
POSTS_PER_DAY=1
PUBLISH_ENABLED=false
AUTO_PUBLISH_AFTER_HOURS=24

# ffmpeg (rutas absolutas; en esta PC ya instalado via winget)
FFMPEG_BIN=C:/Users/brian/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-9.0.2-full_build/bin/ffmpeg.exe
FFPROBE_BIN=C:/Users/brian/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-9.0.2-full_build/bin/ffprobe.exe

# ElevenLabs (la unica API disponible): voiceover PT-BR
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_CHARS_PER_MONTH=10000

# Pexels (fondos premium; emision de keys pausada 2026-10. Sin key usa NASA+Commons, keyless)
PEXELS_API_KEY=

# Telegram (1 toque de aprobacion)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube (fase F2: OAuth installed-app, ver README)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Instagram Login (fase F3: Meta App Review)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Facebook Page (fase F3)
FB_PAGE_TOKEN=
FB_PAGE_ID=
