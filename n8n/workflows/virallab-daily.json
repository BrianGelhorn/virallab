  "connections": {
    "Daily 04:00": { "main": [[{ "node": "Brief + Brain + Render", "type": "main", "index": 0 }]] },
    "Brief + Brain + Render": { "main": [[{ "node": "Notify Telegram", "type": "main", "index": 0 }]] }
