{
  "name": "ViralLab - Daily Brain",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "cronExpression": "0 4 * * *" }] } },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Daily 04:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": { "command": "node C:\\dev\\virallab\\jobs\\daily.mjs" },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Brief + Brain + Render",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3100/notify",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\"day\": \"{{ $now.toISO().slice(0,10) }}\"}"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
